---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import TagList from '../components/TagList.astro';
import { getPublishedArticles, getAllTags } from '../utils/posts';
import { siteConfig } from '../config/site';
import { getOrganizationSchema, getWebSiteSchema } from '../lib/schema';

const allArticles = await getPublishedArticles();
const featuredArticle = allArticles.find(article => article.data.featured) || allArticles[0];
const recentArticles = allArticles.filter(article => article.id !== featuredArticle?.id).slice(0, 6);
const tags = await getAllTags();

// Dynamic JSON-LD structured schemas
const schemas = [
  getOrganizationSchema(),
  getWebSiteSchema(),
];

const formattedFeaturedDate = featuredArticle?.data.publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout schemaJson={schemas}>
  <!-- Hero Section with Highlighted Featured Post -->
  {featuredArticle && (
    <section class="home-hero section container">
      <div class="hero-grid">
        <div class="hero-image-pane">
          <a href={`/${featuredArticle.slug || featuredArticle.id}`}>
            <img src={featuredArticle.data.image} alt={featuredArticle.data.title} class="hero-img" />
          </a>
        </div>
        <div class="hero-text-pane">
          <span class="featured-badge">Featured Article</span>
          <a href={`/${featuredArticle.data.category.toLowerCase()}`} class="featured-category">
            {siteConfig.categories[featuredArticle.data.category.toLowerCase()]?.label || featuredArticle.data.category}
          </a>
          <h2 class="featured-title">
            <a href={`/${featuredArticle.slug || featuredArticle.id}`}>{featuredArticle.data.title}</a>
          </h2>
          <p class="featured-desc">{featuredArticle.data.description}</p>
          <div class="featured-meta">
            <time datetime={featuredArticle.data.publishDate.toISOString()}>{formattedFeaturedDate}</time>
            <span class="meta-separator">&bull;</span>
            <a href={`/${featuredArticle.slug || featuredArticle.id}`} class="read-more-link">Read Article &rarr;</a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Categories Navigation Cards -->
  <section class="home-categories section container">
    <div class="section-header">
      <h2 class="section-title">Explore by Niche</h2>
      <p class="section-desc">Browse our curated guides and tips grouped by interest.</p>
    </div>
    
    <div class="grid-cards">
      {Object.entries(siteConfig.categories).map(([slug, meta]) => (
        <CategoryCard
          slug={slug}
          label={meta.label}
          description={meta.description}
          color={meta.color}
        />
      ))}
    </div>
  </section>

  <!-- Recent Articles & Sidebar -->
  <section class="home-recent section container">
    <div class="home-layout-columns">
      <div class="home-main-col">
        <h2 class="section-title">Latest Articles</h2>
        <div class="recent-grid-cards">
          {recentArticles.map(article => {
            const dateStr = article.data.publishDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
            });
            return (
              <article class="card">
                <a href={`/${article.slug || article.id}`} class="card-link" aria-label={article.data.title}>
                  <img src={article.data.image} alt={article.data.title} class="card-img" />
                </a>
                <div class="card-content">
                  <div class="card-meta">
                    <span class="card-category">
                      {siteConfig.categories[article.data.category.toLowerCase()]?.label || article.data.category}
                    </span>
                    <span class="meta-separator">&bull;</span>
                    <time datetime={article.data.publishDate.toISOString()}>{dateStr}</time>
                  </div>
                  <h3 class="card-title">
                    <a href={`/${article.slug || article.id}`}>{article.data.title}</a>
                  </h3>
                  <p class="card-desc">{article.data.description}</p>
                </div>
              </article>
            );
          })}
        </div>
      </div>
      
      <aside class="home-sidebar-col">
        <div class="sidebar-widget">
          <h4 class="widget-title">Popular Tags</h4>
          <TagList tags={tags.slice(0, 15)} />
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  /* Home Hero Grid */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0;
    overflow: hidden;
  }
  
  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: 1.2fr 1fr;
    }
  }
  
  .hero-image-pane {
    height: 300px;
    width: 100%;
  }
  
  @media (min-width: 768px) {
    .hero-image-pane {
      height: 450px;
    }
  }
  
  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(10%);
    transition: filter 0.3s;
  }

  .hero-grid:hover .hero-img {
    filter: grayscale(0%);
  }
  
  .hero-text-pane {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  
  .featured-badge {
    font-family: system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #ffffff;
    background-color: var(--color-accent);
    padding: 0.25rem 0.6rem;
    border-radius: 0;
    margin-bottom: 1rem;
    letter-spacing: 0.05em;
  }
  
  .featured-category {
    font-family: system-ui, sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }
  
  .featured-title {
    font-family: Georgia, serif;
    font-size: 1.85rem;
    line-height: 1.25;
    margin-bottom: 1rem;
    font-weight: 750;
  }
  
  @media (min-width: 1024px) {
    .featured-title {
      font-size: 2.5rem;
    }
  }
  
  .featured-desc {
    font-family: Georgia, serif;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
    line-height: 1.6;
  }
  
  .featured-meta {
    font-family: system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  
  .meta-separator {
    color: var(--color-border);
  }
  
  .read-more-link {
    font-weight: 800;
    color: var(--color-accent);
  }
  
  /* Sections Header */
  .section-header {
    margin-bottom: 2.5rem;
  }
  
  .section-title {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }
  
  .section-desc {
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }
  
  /* Recent articles grid rules */
  .recent-grid-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  
  @media (min-width: 640px) {
    .recent-grid-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  /* Homepage Columns */
  .home-layout-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  
  @media (min-width: 1024px) {
    .home-layout-columns {
      grid-template-columns: 2fr 1fr;
    }
  }
  
  .sidebar-widget {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }
  
  .widget-title {
    font-size: 1.1rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }
</style>
