---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { siteConfig } from '../config/site';

const seoProps = {
  title: "Privacy Policy",
  description: `Privacy policy and data protection guidelines for ${siteConfig.siteName}.`,
};
---

<BaseLayout seo={seoProps}>
  <Breadcrumbs title="Privacy Policy" />
  
  <div class="container section">
    <div class="legal-content">
      <h1 class="page-title">Privacy Policy</h1>
      <p class="last-updated">Last Updated: July 31, 2026</p>
      
      <p>At {siteConfig.siteName}, we take your privacy seriously. This document outlines the types of personal information we receive and collect when you visit our website, and how we safeguard your information.</p>
      
      <h2>Information We Collect</h2>
      <p>We do not require user accounts or register profiles. The only personal information we collect is data you explicitly provide to us (such as entering your email address in our newsletter subscription form). We also collect anonymous server logs (such as IP addresses, browser types, and referral paths) to monitor website performance and security.</p>
      
      <h2>Cookies and Tracking</h2>
      <p>We use standard local storage configurations and essential cookies to store your preferences (such as light/dark theme selection). Third-party advertising networks or analytics tools may also place cookies on your browser to measure advertisement metrics or visitor demographics.</p>
      
      <h2>Sharing of Information</h2>
      <p>We will never sell, trade, or transfer your email address or personal data to outside parties. This does not include trusted third parties who assist us in operating our website or serving you, so long as those parties agree to keep this information confidential.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .legal-content {
    max-width: 75ch;
    margin: 0 auto;
  }
  
  .page-title {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }
  
  .last-updated {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }
  
  .legal-content h2 {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
  }
  
  .legal-content p {
    margin-bottom: 1.25rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }
</style>
