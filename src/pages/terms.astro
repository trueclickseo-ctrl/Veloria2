---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { siteConfig } from '../config/site';

const seoProps = {
  title: "Terms of Service",
  description: `Terms and conditions for utilizing the resources and guides on ${siteConfig.siteName}.`,
};
---

<BaseLayout seo={seoProps}>
  <Breadcrumbs title="Terms of Service" />
  
  <div class="container section">
    <div class="legal-content">
      <h1 class="page-title">Terms of Service</h1>
      <p class="last-updated">Last Updated: July 31, 2026</p>
      
      <p>Welcome to {siteConfig.siteName}. By accessing or using our website, you agree to comply with and be bound by the following terms and conditions of use.</p>
      
      <h2>1. Intellectual Property</h2>
      <p>All content, branding, design, graphics, compilations, and layouts published on this site are protected by copyright laws. You may read, print, or bookmark our guides for your own personal, non-commercial use. Any redistribution or replication of our content without written permission is strictly prohibited.</p>
      
      <h2>2. Disclaimer of Liability</h2>
      <p>The information provided on this website is for general informational and educational purposes only. While we endeavor to keep the content accurate and up to date, we make no representations or warranties of any kind regarding its completeness or accuracy. Any reliance you place on such information is strictly at your own risk.</p>
      
      <h2>3. Third-Party Links</h2>
      <p>Our articles may contain links to external sites operated by third parties. We have no control over the content, privacy policies, or practices of these sites and assume no responsibility for them.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .legal-content {
    max-width: 75ch;
    margin: 0 auto;
  }
  
  .page-title {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }
  
  .last-updated {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }
  
  .legal-content h2 {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
  }
  
  .legal-content p {
    margin-bottom: 1.25rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }
</style>
