---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const seoProps = {
  title: "404 - Page Not Found",
  description: "Sorry, the page you are looking for does not exist on Veloria Magazine.",
};
---

<BaseLayout seo={seoProps}>
  <Breadcrumbs title="404 Error" />
  
  <div class="container section error-page">
    <div class="error-card">
      <span class="error-code">404</span>
      <h1 class="error-title">Page Not Found</h1>
      <p class="error-text">We're sorry, but the page you are looking for has been moved, deleted, or never existed.</p>
      <div class="error-actions">
        <a href="/" class="btn btn-primary">Go to Homepage</a>
        <a href="/search" class="btn btn-outline">Search Articles</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .error-page {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 50vh;
  }
  
  .error-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 3.5rem;
    text-align: center;
    max-width: 550px;
    box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.3);
  }
  
  .error-code {
    font-size: 5rem;
    font-weight: 900;
    line-height: 1;
    color: var(--color-accent);
    display: block;
    margin-bottom: 1rem;
    letter-spacing: -0.05em;
    background: linear-gradient(135deg, var(--color-accent), var(--color-primary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  
  .error-title {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }
  
  .error-text {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.5;
    margin-bottom: 2rem;
  }
  
  .error-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
