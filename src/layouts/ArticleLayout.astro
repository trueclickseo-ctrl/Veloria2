---
import type { CollectionEntry } from 'astro:content';
import { getEntry, render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleHero from '../components/ArticleHero.astro';
import TableOfContents from '../components/TableOfContents.astro';
import AuthorBox from '../components/AuthorBox.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import FAQ from '../components/FAQ.astro';
import Newsletter from '../components/Newsletter.astro';
import ShareButtons from '../components/ShareButtons.astro';
import BackToTop from '../components/BackToTop.astro';
import { getReadingTime } from '../lib/readingTime';
import { getRelatedArticles } from '../utils/posts';
import { 
  getArticleSchema, 
  getDefinedTermSchema, 
  getCreativeWorkSchema, 
  getFAQSchema,
  getBreadcrumbSchema
} from '../lib/schema';
import { siteConfig } from '../config/site';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { Content, headings } = await render(article);

// Resolve Author reference
const authorEntry = await getEntry(article.data.author);
const authorData = authorEntry ? authorEntry.data : {
  name: "Veloria Editors",
  bio: "Curators of premium lifestyle, finance, and wellness articles.",
  avatar: "/assets/authors/default.jpg",
};

// Calculate reading time
const readingTimeText = getReadingTime(article.body);

// Resolve dynamic URLs
const articleUrl = `${siteConfig.siteUrl}/${article.slug || article.id}`;
const authorUrl = authorEntry ? `${siteConfig.siteUrl}/authors/${authorEntry.id}` : undefined;

// Calculate related posts
const relatedPosts = await getRelatedArticles(article, 3);

// Generate schemas based on schemaType
const schemas: Record<string, any>[] = [];

// Base Breadcrumbs Schema
schemas.push(getBreadcrumbSchema([
  { name: 'Home', item: siteConfig.siteUrl },
  { name: siteConfig.categories[article.data.category.toLowerCase()]?.label || article.data.category, item: `${siteConfig.siteUrl}/${article.data.category.toLowerCase()}` },
  { name: article.data.title, item: articleUrl }
]));

// Type-specific Schema
if (article.data.schemaType === 'Article') {
  schemas.push(getArticleSchema({
    title: article.data.title,
    description: article.data.description,
    publishDate: article.data.publishDate,
    updatedDate: article.data.updatedDate,
    image: article.data.image,
    url: articleUrl,
    authorName: authorData.name,
    authorUrl,
    category: article.data.category,
  }));
} else if (article.data.schemaType === 'DefinedTerm') {
  schemas.push(getDefinedTermSchema({
    name: article.data.title,
    description: article.data.description,
    url: articleUrl,
  }));
} else if (article.data.schemaType === 'CreativeWork') {
  schemas.push(getCreativeWorkSchema({
    name: article.data.title,
    description: article.data.description,
    url: articleUrl,
    authorName: authorData.name,
    publishDate: article.data.publishDate,
  }));
}

// Conditionally append FAQ Schema
if (article.data.faq && article.data.faq.length > 0) {
  schemas.push(getFAQSchema(article.data.faq));
}

const seoProps = {
  title: article.data.title,
  description: article.data.description,
  image: article.data.image,
  canonicalUrl: articleUrl,
  type: 'article' as const,
  publishDate: article.data.publishDate,
  updatedDate: article.data.updatedDate,
  authorName: authorData.name,
};

const subheadings = headings.filter(h => h.depth === 2);
---

<BaseLayout seo={seoProps} schemaJson={schemas}>
  <Breadcrumbs category={article.data.category} title={article.data.title} />
  
  <!-- Floating Sidebar Tabs representing sections -->
  {subheadings.length > 0 && (
    <nav class="heading-nav-tabs">
      <span class="nav-tabs-title">Sections</span>
      {subheadings.map(h => (
        <a href={`#${h.slug}`} class="tab-nav-item">{h.text}</a>
      ))}
    </nav>
  )}
  
  <article class="article-detail-page container" data-pagefind-body>
    <ArticleHero
      title={article.data.title}
      description={article.data.description}
      publishDate={article.data.publishDate}
      updatedDate={article.data.updatedDate}
      category={article.data.category}
      image={article.data.image}
      authorName={authorData.name}
      authorAvatar={authorData.avatar}
      readingTime={readingTimeText}
    />
    
    <div class="article-layout-grid">
      <div class="article-main-content">
        <!-- Conditional Table of Contents -->
        <TableOfContents headings={headings} />
        
        <!-- Main Article Content Body -->
        <div class="prose-content">
          <Content />
        </div>
        
        <!-- Conditional FAQ Accordion -->
        <FAQ faqs={article.data.faq} />
        
        <!-- Share Buttons -->
        <ShareButtons title={article.data.title} url={articleUrl} />
        
        <!-- Author Profile Box -->
        <AuthorBox
          name={authorData.name}
          bio={authorData.bio}
          avatar={authorData.avatar}
          twitter={authorData.twitter}
          facebook={authorData.facebook}
          github={authorData.github}
          website={authorData.website}
        />
        
        <!-- Related Posts Grid -->
        <RelatedPosts posts={relatedPosts} />
      </div>
    </div>
  </article>
  
  <BackToTop />
</BaseLayout>

<style>
  .article-detail-page {
    margin-top: 2rem;
  }
  
  .article-layout-grid {
    max-width: 850px;
    margin: 0 auto;
  }
  
  /* Vertical Floating side tabs layout */
  .heading-nav-tabs {
    position: fixed;
    right: 2rem;
    top: 180px;
    display: none;
    flex-direction: column;
    gap: 0.75rem;
    z-index: 50;
    border-left: 2px solid var(--color-primary);
    padding-left: 1rem;
    max-width: 200px;
  }

  .nav-tabs-title {
    font-family: system-ui, sans-serif;
    font-size: 0.7rem;
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: 0.25rem;
  }

  .tab-nav-item {
    font-family: system-ui, sans-serif;
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-text-muted);
    transition: all 0.2s ease;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    line-height: 1.3;
  }

  .tab-nav-item:hover {
    color: var(--color-primary);
    padding-left: 0.25rem;
  }

  @media (min-width: 1350px) {
    .heading-nav-tabs {
      display: flex;
    }
  }
  
  .prose-content {
    font-family: Georgia, Cambria, serif;
    font-size: 1.15rem;
    line-height: 1.85;
    color: var(--color-text);
  }
  
  .prose-content :global(p) {
    margin-bottom: 1.75rem;
    text-align: justify;
  }
  
  .prose-content :global(a) {
    border-bottom: 2px dashed var(--color-accent);
    color: var(--color-text);
  }
  
  .prose-content :global(a:hover) {
    border-bottom-style: solid;
    color: var(--color-accent);
  }
  
  .prose-content :global(ul), .prose-content :global(ol) {
    margin-bottom: 1.75rem;
    padding-left: 2.25rem;
  }
  
  .prose-content :global(li) {
    margin-bottom: 0.75rem;
  }
  
  .prose-content :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: 1.5rem;
    margin: 2.5rem 0;
    font-style: italic;
    color: var(--color-text-muted);
    font-size: 1.25rem;
  }
  
  .prose-content :global(img) {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    margin: 2.5rem 0;
  }
  

</style>
