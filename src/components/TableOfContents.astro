---
interface Props {
  headings: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
}

const { headings } = Astro.props;

// Filter to h2 and h3 elements for table of contents
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);

// Threshold check: render nothing if fewer than 3 headings are present
const shouldRender = tocHeadings.length >= 3;
---

{shouldRender && (
  <nav class="toc-container" aria-label="Table of contents">
    <div class="toc-header">
      <span class="toc-title">Table of Contents</span>
    </div>
    <ul class="toc-list">
      {tocHeadings.map(heading => (
        <li class={`toc-item depth-${heading.depth}`}>
          <a href={`#${heading.slug}`} class="toc-link">
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc-container {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }
  
  .toc-header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.75rem;
    margin-bottom: 1rem;
  }
  
  .toc-title {
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--color-text);
  }
  
  .toc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .toc-item.depth-3 {
    padding-left: 1rem;
    font-size: 0.9rem;
  }
  
  .toc-link {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    display: inline-block;
  }
  
  .toc-link:hover {
    color: var(--color-primary);
  }
</style>
