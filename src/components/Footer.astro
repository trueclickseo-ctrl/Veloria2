---
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-brand-section">
      <h3 class="footer-logo">{siteConfig.siteName}</h3>
      <p class="footer-tagline">{siteConfig.tagline}</p>
      <p class="footer-desc">{siteConfig.description}</p>
    </div>
    
    <div class="footer-nav-section">
      <h4 class="footer-title">Quick Links</h4>
      <ul class="footer-links">
        {siteConfig.navigation.footer.map(link => (
          <li><a href={link.href} class="footer-link">{link.label}</a></li>
        ))}
      </ul>
    </div>
    
    <div class="footer-social-section">
      <h4 class="footer-title">Connect With Us</h4>
      <div class="social-icons">
        {siteConfig.socialLinks.twitter && (
          <a href={siteConfig.socialLinks.twitter} target="_blank" rel="noopener noreferrer" aria-label="Twitter">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>
          </a>
        )}
        {siteConfig.socialLinks.facebook && (
          <a href={siteConfig.socialLinks.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          </a>
        )}
        {siteConfig.socialLinks.instagram && (
          <a href={siteConfig.socialLinks.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
        )}
      </div>
    </div>
  </div>
  
  <div class="container footer-bottom">
    <p>&copy; {currentYear} {siteConfig.siteName}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: 3.5rem 0 2rem 0;
    margin-top: 4rem;
    color: var(--color-text-muted);
  }
  
  .footer-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  
  @media (min-width: 768px) {
    .footer-container {
      grid-template-columns: 2fr 1fr 1fr;
      gap: 4rem;
    }
  }
  
  .footer-logo {
    font-size: 1.4rem;
    font-weight: 900;
    margin-bottom: 0.5rem;
    color: var(--color-text);
    letter-spacing: -0.04em;
  }
  
  .footer-tagline {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }
  
  .footer-desc {
    font-size: 0.85rem;
    line-width: 1.5;
    max-width: 400px;
  }
  
  .footer-title {
    color: var(--color-text);
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.25rem;
  }
  
  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  
  .footer-link {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }
  
  .footer-link:hover {
    color: var(--color-primary);
  }
  
  .social-icons {
    display: flex;
    gap: 0.75rem;
  }
  
  .social-icons a {
    color: var(--color-text-muted);
    background-color: var(--color-background);
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    transition: all 0.2s ease;
  }
  
  .social-icons a:hover {
    color: #ffffff;
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }
  
  .footer-bottom {
    padding-top: 1.5rem;
    text-align: center;
    font-size: 0.8rem;
  }
</style>
