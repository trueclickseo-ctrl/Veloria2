---

<div class="search-wrapper">
  <!-- Dynamic loading of Pagefind assets generated during build -->
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script src="/pagefind/pagefind-ui.js" is:inline></script>

  <div id="pagefind-search"></div>

  <script is:inline>
    function initPagefind() {
      if (typeof PagefindUI !== 'undefined') {
        new PagefindUI({
          element: "#pagefind-search",
          showSubResults: true,
          showImages: true,
          translations: {
            placeholder: "Type keywords to search articles..."
          }
        });
        
        // Focus the input field automatically
        const input = document.querySelector('.pagefind-ui__search-input');
        if (input) input.focus();
      } else {
        document.getElementById('pagefind-search').innerHTML = 
          `<div class="search-fallback-warning">
            <p>Search index is compiled at build time. Build the project and run preview to test search functionality.</p>
           </div>`;
      }
    }

    // Initialize search on load
    window.addEventListener('DOMContentLoaded', initPagefind);
  </script>
</div>

<style>
  .search-wrapper {
    width: 100%;
    margin: 2rem 0;
  }
  
  .search-fallback-warning {
    background-color: var(--color-surface);
    border: 1px dashed var(--color-accent);
    border-radius: 8px;
    padding: 1.5rem;
    text-align: center;
    color: var(--color-text-muted);
  }
</style>
