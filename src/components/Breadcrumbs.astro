---
import { siteConfig } from '../config/site';

interface Props {
  category?: string;
  title?: string;
}

const { category, title } = Astro.props;

// Resolve display name for the category
const categoryLabel = category && siteConfig.categories[category.toLowerCase()]
  ? siteConfig.categories[category.toLowerCase()].label
  : category;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <div class="container">
    <ol class="breadcrumbs-list">
      <li class="breadcrumb-item">
        <a href="/" class="breadcrumb-link">Home</a>
      </li>
      {category && (
        <li class="breadcrumb-item">
          <svg class="breadcrumb-separator" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
          <a href={`/${category.toLowerCase()}`} class="breadcrumb-link">{categoryLabel}</a>
        </li>
      )}
      {title && (
        <li class="breadcrumb-item active" aria-current="page">
          <svg class="breadcrumb-separator" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
          <span class="breadcrumb-text">{title}</span>
        </li>
      )}
    </ol>
  </div>
</nav>

<style>
  .breadcrumbs {
    padding: 1rem 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  
  .breadcrumbs-list {
    list-style: none;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  .breadcrumb-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .breadcrumb-link {
    color: var(--color-text-muted);
    font-weight: 500;
  }
  
  .breadcrumb-link:hover {
    color: var(--color-primary);
  }
  
  .breadcrumb-separator {
    color: var(--color-text-muted);
    opacity: 0.5;
  }
  
  .breadcrumb-text {
    color: var(--color-text);
    font-weight: 600;
    max-width: 250px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  @media (min-width: 640px) {
    .breadcrumb-text {
      max-width: 400px;
    }
  }
</style>
